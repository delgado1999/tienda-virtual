# =====================================================================
# VARIABLES DE ENTORNO - TIENDA VIRTUAL
# Copiar este archivo como ".env" y ajustar los valores si es necesario.
#   copy .env.example .env      (Windows PowerShell / CMD)
#   cp .env.example .env        (Linux / macOS)
# NUNCA subir el archivo .env real al repositorio.
# =====================================================================

# ---- MySQL ----
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_USER=tienda
MYSQL_PASSWORD=tienda123
MYSQL_PORT=3306

# ---- Puertos de los servicios ----
GATEWAY_PORT=8080
USUARIOS_PORT=8081
PRODUCTOS_PORT=8082
PEDIDOS_PORT=8083
PAGOS_PORT=8084
FRONTEND_PORT=8085

# ---- Seguridad JWT ----
# Cadena usada para firmar los tokens. Debe tener al menos 32 caracteres.
JWT_SECRET=ClaveSecretaSuperSeguraParaLaTiendaVirtual2025CambiarEnProduccion
# Tiempo de expiracion del token en milisegundos (86400000 = 24 horas)
JWT_EXPIRATION=86400000

# ---- Credenciales del administrador inicial (se crean al arrancar usuarios) ----
ADMIN_NOMBRE=Administrador General
ADMIN_CORREO=admin@tienda.com
ADMIN_PASSWORD=Admin123
